---
import Layout from '../../layouts/Layout.astro'
const lang = 'zh'

const faqs = [
  { q: '第一次來診所需要準備什麼？', a: '建議攜帶健保卡、過去的影像資料（X光、MRI、超音波報告）及用藥清單。若有過去的診斷書或出院病摘，一併帶來有助於評估。' },
  { q: '初診需要多久時間？', a: '初診通常需要 40–60 分鐘，包含病史詢問、理學檢查及超音波評估。若當天需要治療，請預留 90 分鐘。' },
  { q: '診所有健保嗎？', a: '部分診療項目提供健保給付，自費項目另計。詳細說明請參考費用參考頁面。' },
  { q: '可以帶家人一起進診間嗎？', a: '可以，尤其是行動不便或需要協助溝通的患者，歡迎家屬陪同。診間空間有限，建議以一位家屬為主。' },
  { q: '超音波導引注射會很痛嗎？', a: '注射前會先以局部麻醉藥減少不適，多數患者描述為輕微酸脹感，整個過程約 10–15 分鐘。' },
  { q: '一次治療就夠嗎？', a: '依症狀嚴重程度與組織狀況而定。急性問題有時一次即可改善，慢性或退化性問題通常需要 2–4 次療程，每次間隔 4–6 週。' },
  { q: '治療後有什麼注意事項？', a: '注射後建議當天避免劇烈運動，可正常生活。詳細的術後照護說明會在治療當天提供。' },
  { q: '如何預約門診？', a: '可透過官網預約表單、LINE 或電話預約。初診建議提前預約，避免等候。' },
]
---

<Layout
  title="就診常見問題｜鈷嵐診所・蘆洲疼痛治療"
  description="鈷嵐診所就診常見問題，包含初診準備、費用說明、治療流程、注射後注意事項等，幫助您安心來診。"
  lang={lang}
  pathname="faq"
>

  <section class="fv-hero">
    <div class="container">
      <p class="fv-eyebrow">常見問題</p>
      <h1>就診前，您可能想知道的事</h1>
      <p class="fv-tagline">初診流程・費用・治療說明・注射後照護</p>
    </div>
  </section>

  <section class="fv-section">
    <div class="container">
      <h2>就診常見問題</h2>
      <div class="fv-faq">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="fv-section">
    <div class="container">
      <h2>還有其他問題？</h2>
      <p>歡迎透過 LINE 或電話直接詢問，診所助理會在門診時間內回覆。</p>
      <div class="fv-cta-row">
        <a href="/zh/#book" class="fv-cta fv-cta-line">LINE 諮詢</a>
        <a href="/zh/first-visit/" class="fv-cta fv-cta-ghost">初診說明</a>
      </div>
    </div>
  </section>

</Layout>
