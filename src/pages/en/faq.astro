---
import Layout from '../../layouts/Layout.astro'
const lang = 'en'

const faqs = [
  { q: 'What should I bring to my first visit?', a: 'Please bring your ID, any previous imaging (X-ray, MRI, ultrasound reports), and a list of current medications. Prior diagnosis letters or discharge summaries are also helpful.' },
  { q: 'How long does the initial consultation take?', a: 'The first visit typically takes 40–60 minutes, including history-taking, physical examination, and ultrasound assessment. If treatment is needed the same day, allow 90 minutes.' },
  { q: 'Is the clinic covered by National Health Insurance?', a: 'Some services are covered by National Health Insurance; others are self-pay. Please refer to our Fees page for details.' },
  { q: 'Can I bring a family member into the consultation room?', a: 'Yes, especially for patients with mobility difficulties or communication needs. Space is limited, so we recommend one accompanying family member.' },
  { q: 'Is ultrasound-guided injection painful?', a: 'A local anaesthetic is applied beforehand to minimise discomfort. Most patients describe mild pressure or a brief ache. The procedure typically takes 10–15 minutes.' },
  { q: 'Will one treatment be enough?', a: 'It depends on the severity and tissue condition. Acute issues may respond after one session; chronic or degenerative conditions usually require 2–4 sessions spaced 4–6 weeks apart.' },
  { q: 'What should I do after treatment?', a: 'Avoid strenuous activity on the day of injection. Normal daily activities are fine. Detailed aftercare instructions will be provided at your visit.' },
  { q: 'How do I book an appointment?', a: 'You can book via our online form, LINE, or by phone. We recommend booking in advance for first visits.' },
]
---

<Layout
  title="FAQ | Colan Clinic — Musculoskeletal & Pain Care, Luzhou"
  description="Answers to common questions about visiting Colan Clinic: what to bring, fees, treatment process, and aftercare."
  lang={lang}
  pathname="faq"
>

  <section class="fv-hero">
    <div class="container">
      <p class="fv-eyebrow">FAQ</p>
      <h1>Questions Before Your Visit</h1>
      <p class="fv-tagline">First visit · Fees · Treatments · Aftercare</p>
    </div>
  </section>

  <section class="fv-section">
    <div class="container">
      <h2>Frequently Asked Questions</h2>
      <div class="fv-faq">
        {faqs.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="fv-section">
    <div class="container">
      <h2>Still have questions?</h2>
      <p>Feel free to reach us via LINE or phone during clinic hours.</p>
      <div class="fv-cta-row">
        <a href="/en/#book" class="fv-cta fv-cta-line">Contact via LINE</a>
        <a href="/en/first-visit/" class="fv-cta fv-cta-ghost">First Visit Guide</a>
      </div>
    </div>
  </section>

</Layout>
