---
import Layout from '../../layouts/Layout.astro'
const lang = 'en'
---

<Layout
  title="Treatment Journeys | Colan Clinic — Pain Specialist"
  description="Objective clinical accounts of treatment pathways at Colan Clinic — assessment findings, treatment rationale, and post-procedure follow-up."
  lang={lang}
  pathname="testimonials"
>

  <section class="fv-hero">
    <div class="container">
      <p class="fv-eyebrow">Treatment Journeys</p>
      <h1>Clinical Case Summaries</h1>
      <p class="fv-tagline">Assessment · Treatment rationale · Follow-up</p>
    </div>
  </section>

  <section class="fv-section">
    <div class="container">
      <h2>About This Page</h2>
      <p>These are objective clinical summaries of treatment pathways seen at Colan Clinic. Each account describes the assessment findings, the reasoning behind treatment choices, and the follow-up process. No patient names or outcome guarantees are included.</p>
      <p>Content is being added progressively. Check back soon.</p>
    </div>
  </section>

  <section class="fv-section">
    <div class="container">
      <h2>Want to learn more?</h2>
      <p>Browse our articles or book a consultation.</p>
      <div class="fv-cta-row">
        <a href="/en/articles/" class="fv-cta fv-cta-ghost">Read Articles</a>
        <a href="/en/#book" class="fv-cta fv-cta-line">Book a Visit</a>
      </div>
    </div>
  </section>

</Layout>
